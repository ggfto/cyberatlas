# Binario nativo do hub numa imagem micro (glibc minima, sem shell de pacote). Multi-arch: a base tem
# amd64 e arm64, e cada arquitetura entra com o binario nativo compilado nela (GraalVM nao faz cross).
FROM quay.io/quarkus/ubi9-quarkus-micro-image:2.0@sha256:eabc0757b1d70693ab53a04deabbf49a6669713f1010415ac60324bfd9a63dab
WORKDIR /work/
RUN chown 1001 /work && chmod "g+rwX" /work && chown 1001:root /work
COPY --chown=1001:root --chmod=0755 target/*-runner /work/application
EXPOSE 8080
USER 1001
ENTRYPOINT ["./application", "-Dquarkus.http.host=0.0.0.0"]
