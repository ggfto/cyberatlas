# Copie para .env (NAO versionar). Valores sensiveis em branco.
# Imagem por digest, nunca latest: ghcr.io/ggfto/cyberatlas-edge@sha256:...
ATLAS_EDGE_IMAGE=
# host ou vps (o hub confere com o certificado emitido no enrollment)
ATLAS_EDGE_MACHINE=
# host: https://10.99.0.1:30843 (pelo WG) | vps: https://172.17.0.1:30843 (pelo docker0; o cert da 8443 tem esses IPs)
ATLAS_EDGE_HUB=
# Token de uso unico de POST /api/edges (atlas-admins). Apague depois do primeiro start.
ATLAS_EDGE_TOKEN=
# getent group docker | cut -d: -f3
DOCKER_GID=
# API interna do Traefik da maquina (so routers/services), ex.: http://host.docker.internal:8080; vazio desliga
ATLAS_EDGE_TRAEFIK=
# true para ler o k3s da maquina com a SA atlas-edge
ATLAS_EDGE_KUBERNETES=false
ATLAS_EDGE_KUBECONFIG=./kubeconfig
